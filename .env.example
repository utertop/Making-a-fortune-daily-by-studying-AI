# AI Signal Radar v0.1 local configuration

APP_ENV=local
APP_NAME=AI Signal Radar

# API
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/local.db

# Web
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Push
PUSH_CHANNEL=feishu
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# GitHub
GITHUB_TOKEN=

# Optional LLM enrichment. Keep disabled until you add a compatible API key.
AI_SIGNAL_RADAR_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
AI_SIGNAL_RADAR_LLM_TIMEOUT_SECONDS=20
AI_SIGNAL_RADAR_LLM_DAILY_LIMIT=20
AI_SIGNAL_RADAR_LLM_MAX_OUTPUT_TOKENS=500
AI_SIGNAL_RADAR_LLM_TEMPERATURE=0.2
